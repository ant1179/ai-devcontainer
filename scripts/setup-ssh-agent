#!/usr/bin/env bash

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

PROJECT_NAME="$(basename "${REPO_ROOT}")"
SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"
SSH_AGENT_SOCKET="${SECRETS_DIR}/ssh-agent.sock"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

mkdir -p "${SECRETS_DIR}"
chmod 700 "${SECRETS_DIR}"

cleanup_ssh_agent() {
  local old_ssh_agent_pid=""
  local process_name=""

  if [[ -f "${SSH_AGENT_ENV}" ]]; then
    old_ssh_agent_pid="$(
      grep '^SSH_AGENT_PID=' "${SSH_AGENT_ENV}" 2>/dev/null |
        cut -d= -f2- || true
    )"

    if [[ -n "${old_ssh_agent_pid}" ]] &&
      kill -0 "${old_ssh_agent_pid}" 2>/dev/null; then

      process_name="$(
        ps -p "${old_ssh_agent_pid}" -o comm= 2>/dev/null || true
      )"

      if [[ "${process_name}" == *ssh-agent* ]]; then
        echo "Stopping previous dedicated SSH agent..."
        kill "${old_ssh_agent_pid}"
      fi
    fi
  fi

  rm -f "${SSH_AGENT_SOCKET}"
  rm -f "${SSH_AGENT_ENV}"
}

setup_ssh_agent() {
  local ssh_dir="${HOME}/.ssh"
  local private_keys=()
  local key
  local selection
  local selected_index

  cleanup_ssh_agent

  if [[ ! -d "${ssh_dir}" ]]; then
    echo "SSH directory not found: ${ssh_dir}" >&2
    exit 1
  fi

  while IFS= read -r key; do
    case "$(basename "${key}")" in
    *.pub | known_hosts | known_hosts.old | authorized_keys | config)
      continue
      ;;
    esac

    if ssh-keygen -y -f "${key}" >/dev/null 2>&1; then
      private_keys+=("${key}")
    fi
  done < <(find "${ssh_dir}" -maxdepth 1 -type f | sort)

  if [[ ${#private_keys[@]} -eq 0 ]]; then
    echo "No SSH private keys found."
    return
  fi

  echo
  echo "Available SSH private keys:"
  echo

  for i in "${!private_keys[@]}"; do
    printf "  %d) %s\n" "$((i + 1))" "${private_keys[$i]}"
  done

  echo
  read -rp "Select keys to expose to the devcontainer (e.g. 1 2, empty for none): " selection

  if [[ -z "${selection}" ]]; then
    echo "No SSH key selected."
    return
  fi

  eval "$(ssh-agent -a "${SSH_AGENT_SOCKET}" -s)" >/dev/null

  {
    echo "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}"
    echo "SSH_AGENT_PID=${SSH_AGENT_PID}"
  } >"${SSH_AGENT_ENV}"

  chmod 600 "${SSH_AGENT_ENV}"

  for selected_index in ${selection}; do
    if ! [[ "${selected_index}" =~ ^[0-9]+$ ]]; then
      echo "Invalid selection: ${selected_index}" >&2
      cleanup_ssh_agent
      exit 1
    fi

    if ((selected_index < 1 || selected_index > ${#private_keys[@]})); then
      echo "Invalid selection: ${selected_index}" >&2
      cleanup_ssh_agent
      exit 1
    fi

    ssh-add "${private_keys[$((selected_index - 1))]}"
  done

  echo
  echo "SSH keys exposed to the devcontainer:"
  ssh-add -l
}

if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  setup_ssh_agent
else
  cleanup_ssh_agent
  echo "SSH agent: disabled (bunkered mode)"
fi
