#!/usr/bin/env bash

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"
RECREATE="${2:-false}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

PROJECT_NAME="$(basename "${REPO_ROOT}")"
SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

# Make the selected security mode the active DevPod context.
devpod context use "${SECURITY_MODE}"
echo

# Prepare persistent build secrets.
"${SCRIPT_DIR}/setup-secrets" "${SECURITY_MODE}" "${RECREATE}"

# Configure the dedicated SSH agent.
"${SCRIPT_DIR}/setup-ssh-agent" "${SECURITY_MODE}"

# Make the dedicated SSH agent available to DevPod in hardened mode.
if [[ "${SECURITY_MODE}" == "hardened" && -f "${SSH_AGENT_ENV}" ]]; then
  # shellcheck disable=SC1090
  source "${SSH_AGENT_ENV}"
  export SSH_AUTH_SOCK
  export SSH_AGENT_PID
else
  unset SSH_AUTH_SOCK || true
  unset SSH_AGENT_PID || true
fi

# Build the devcontainer image.
"${SCRIPT_DIR}/build-image" "${SECURITY_MODE}"

# Generate the security-specific Compose configuration.
"${SCRIPT_DIR}/generate-compose" "${SECURITY_MODE}"

# Start the DevPod workspace.
"${SCRIPT_DIR}/start-devpod" "${SECURITY_MODE}" "${RECREATE}"
