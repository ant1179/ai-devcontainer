#!/usr/bin/env bash

# Wraps DevPod commands with project-specific behavior.
#
# The wrapper exposes the dedicated SSH agent when available, ensures SSH
# sessions start in the workspace, and cleans up project-specific SSH agent
# resources when the DevPod workspace is deleted.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

CONFIG_FILE="${REPO_ROOT}/.env"

if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "Configuration file not found: ${CONFIG_FILE}" >&2
  exit 1
fi

# Load project configuration.
# shellcheck disable=SC1090
source "${CONFIG_FILE}"

if [[ -z "${PROJECT_NAME:-}" ]]; then
  echo "PROJECT_NAME is not configured." >&2
  exit 1
fi

SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"
SSH_AGENT_SOCKET="${SECRETS_DIR}/ssh-agent.sock"

# Stop only the SSH agent previously created for this project.
# Verify the recorded PID still belongs to ssh-agent before killing it.
cleanup_ssh_agent() {
  local old_ssh_agent_pid=""
  local process_name=""

  if [[ -f "${SSH_AGENT_ENV}" ]]; then
    old_ssh_agent_pid="$(
      grep '^SSH_AGENT_PID=' "${SSH_AGENT_ENV}" 2>/dev/null |
        cut -d= -f2- || true
    )"

    if [[ -n "${old_ssh_agent_pid}" ]] &&
      kill -0 "${old_ssh_agent_pid}" 2>/dev/null; then

      process_name="$(
        ps -p "${old_ssh_agent_pid}" -o comm= 2>/dev/null || true
      )"

      if [[ "${process_name}" == *ssh-agent* ]]; then
        echo "Stopping dedicated SSH agent..."
        kill "${old_ssh_agent_pid}"
      fi
    fi
  fi

  rm -f "${SSH_AGENT_SOCKET}"
  rm -f "${SSH_AGENT_ENV}"
}

# Expose only the project-specific SSH agent to DevPod.
# Never fall back to the host SSH agent when the dedicated socket is absent.
if [[ -S "${SSH_AGENT_SOCKET}" ]]; then
  export SSH_AUTH_SOCK="${SSH_AGENT_SOCKET}"
else
  unset SSH_AUTH_SOCK || true
fi

# Delete the DevPod workspace first, then clean up its dedicated SSH agent.
if [[ "${1:-}" == "delete" ]]; then
  devpod "$@"
  cleanup_ssh_agent
  exit 0
fi

# Always enter the container directly in the project workspace.
if [[ "${1:-}" == "ssh" ]]; then
  exec devpod "$@" --workdir /workspaces/vscode
fi

exec devpod "$@"
