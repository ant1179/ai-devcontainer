#!/usr/bin/env bash

# Generates the security-specific Docker Compose overlay.
#
# The overlay applies runtime hardening for the selected security mode and
# masks workspace paths matching the AI denylist so they are not accessible
# from inside the devcontainer.

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

DENYLIST_FILE="${REPO_ROOT}/.devcontainer/ai-denylist"
GENERATED_FILE="${REPO_ROOT}/.devcontainer/docker-compose.generated.yaml"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

if [[ ! -f "${DENYLIST_FILE}" ]]; then
  echo "Denylist not found: ${DENYLIST_FILE}" >&2
  exit 1
fi

# Resolve denylist patterns on the host before the workspace is mounted.
# The resulting paths will later be masked inside the container.
TMP_MATCHES="$(mktemp)"
trap 'rm -f "${TMP_MATCHES}"' EXIT

while IFS= read -r pattern; do
  [[ -z "${pattern}" ]] && continue
  [[ "${pattern}" =~ ^[[:space:]]*# ]] && continue

  (
    cd "${REPO_ROOT}"

    find . \
      -path "./.git" -prune \
      -o -path "./${pattern}" -print
  ) >>"${TMP_MATCHES}"

done <"${DENYLIST_FILE}"

{
  echo "services:"
  echo "  app:"

  # Start from an empty capability set, then restore only the capabilities
  # required by each security mode during container initialization.
  echo "    cap_drop:"
  echo "      - ALL"

  # Hardened mode allows controlled privilege escalation through sudo.
  # Bunkered mode prevents privilege escalation entirely with no-new-privileges.
  if [[ "${SECURITY_MODE}" == "hardened" ]]; then
    echo "    cap_add:"
    echo "      - SETUID"
    echo "      - SETGID"
    echo "      - AUDIT_WRITE"
    echo "      - DAC_OVERRIDE"
  else
    echo "    cap_add:"
    echo "      - SETUID"
    echo "      - SETGID"
    echo "      - CHOWN"
    echo "      - DAC_OVERRIDE"
    echo "    security_opt:"
    echo "      - no-new-privileges:true"
  fi

  echo "    volumes:"

  # Mask denied directories with empty tmpfs mounts and denied files with
  # read-only /dev/null mounts. This prevents tools and AI agents inside the
  # workspace from reading the original host content.
  sort -u "${TMP_MATCHES}" | while IFS= read -r file; do
    relative="${file#./}"

    if [[ -d "${REPO_ROOT}/${relative}" ]]; then
      echo "      - type: tmpfs"
      echo "        target: /workspaces/vscode/${relative}"
      echo "        tmpfs:"
      echo "          mode: 0700"
    else
      echo "      - /dev/null:/workspaces/vscode/${relative}:ro"
    fi
  done

} >"${GENERATED_FILE}"

echo
echo "Generated: ${GENERATED_FILE}"
