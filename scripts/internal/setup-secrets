#!/usr/bin/env bash

# Manages host-side secrets required to build and configure the devcontainer.
#
# Secrets are stored outside the workspace in a project-specific directory
# with restrictive permissions. They are never written to the project .env.
#
# The GitHub token is reused across recreations, while hardened mode requests
# a sudo password and generates a new password hash for each recreation.

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

CONFIG_FILE="${REPO_ROOT}/.env"

if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "Configuration file not found: ${CONFIG_FILE}" >&2
  exit 1
fi

# Load project configuration.
# shellcheck disable=SC1090
source "${CONFIG_FILE}"

if [[ -z "${PROJECT_NAME:-}" ]]; then
  echo "PROJECT_NAME is not configured." >&2
  exit 1
fi

SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
ENV_FILE="${SECRETS_DIR}/secrets.env"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

# Keep secrets outside the workspace so tools and AI agents running inside
# the devcontainer cannot access them through the project mount.
mkdir -p "${SECRETS_DIR}"
chmod 700 "${SECRETS_DIR}"

touch "${ENV_FILE}"
chmod 600 "${ENV_FILE}"

get_secret() {
  local key="$1"

  grep "^${key}=" "${ENV_FILE}" 2>/dev/null |
    cut -d= -f2- || true
}

# Update a single secret atomically without exposing a temporary file in /tmp.
set_secret() {
  local key="$1"
  local value="$2"
  local tmp_file

  tmp_file="$(mktemp "${SECRETS_DIR}/secrets.env.XXXXXX")"
  chmod 600 "${tmp_file}"

  grep -v "^${key}=" "${ENV_FILE}" >"${tmp_file}" || true
  printf '%s=%s\n' "${key}" "${value}" >>"${tmp_file}"

  mv "${tmp_file}" "${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
}

MISE_GITHUB_TOKEN="$(get_secret MISE_GITHUB_TOKEN)"

if [[ -z "${MISE_GITHUB_TOKEN}" ]]; then
  echo
  read -rsp "🔒 GitHub token for mise: " MISE_GITHUB_TOKEN
  echo

  if [[ -z "${MISE_GITHUB_TOKEN}" ]]; then
    echo "GitHub token cannot be empty." >&2
    exit 1
  fi

  set_secret MISE_GITHUB_TOKEN "${MISE_GITHUB_TOKEN}"
fi

# Hardened mode uses a fresh sudo password on every recreation.
# Only its hash is persisted; the plaintext password remains in memory.
if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  echo
  read -rsp "🔒 Sudo password for vscode: " VSCODE_PASSWORD
  echo

  read -rsp "🔒 Confirm sudo password: " VSCODE_PASSWORD_CONFIRM
  echo

  if [[ "${VSCODE_PASSWORD}" != "${VSCODE_PASSWORD_CONFIRM}" ]]; then
    echo "Passwords do not match." >&2
    exit 1
  fi

  if [[ -z "${VSCODE_PASSWORD}" ]]; then
    echo "Password cannot be empty." >&2
    exit 1
  fi

  VSCODE_PASSWORD_HASH="$(
    printf '%s' "${VSCODE_PASSWORD}" |
      openssl passwd -6 -stdin
  )"

  VSCODE_PASSWORD_CACHE_KEY="$(
    openssl rand -hex 16
  )"

  set_secret VSCODE_PASSWORD_HASH "${VSCODE_PASSWORD_HASH}"
  set_secret VSCODE_PASSWORD_CACHE_KEY "${VSCODE_PASSWORD_CACHE_KEY}"

  unset VSCODE_PASSWORD
  unset VSCODE_PASSWORD_CONFIRM
fi

echo
echo "Secrets ready: ${ENV_FILE}"
