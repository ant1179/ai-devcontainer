#!/usr/bin/env bash

# Orchestrates the complete recreation of the devcontainer environment.
#
# This script prepares host-side secrets and SSH access, builds the image,
# generates the security-specific Compose overlay, and recreates the
# DevPod workspace using the selected security mode.

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

CONFIG_FILE="${REPO_ROOT}/.env"

if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "Configuration file not found: ${CONFIG_FILE}" >&2
  exit 1
fi

# Load project configuration.
# shellcheck disable=SC1090
source "${CONFIG_FILE}"

if [[ -z "${PROJECT_NAME:-}" ]]; then
  echo "PROJECT_NAME is not configured." >&2
  exit 1
fi

SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

# Make the selected security mode the active DevPod context.
devpod context use "${SECURITY_MODE}"
echo

# Configure a dedicated SSH agent in hardened mode, or remove it in bunkered mode.
"${SCRIPT_DIR}/setup-secrets" "${SECURITY_MODE}"

# Configure the dedicated SSH agent.
"${SCRIPT_DIR}/setup-ssh-agent" "${SECURITY_MODE}"

# Make the dedicated SSH agent available to DevPod in hardened mode.
if [[ "${SECURITY_MODE}" == "hardened" && -f "${SSH_AGENT_ENV}" ]]; then
  # shellcheck disable=SC1090
  source "${SSH_AGENT_ENV}"
  export SSH_AUTH_SOCK
  export SSH_AGENT_PID
else
  unset SSH_AUTH_SOCK || true
  unset SSH_AGENT_PID || true
fi

# Build the devcontainer image.
"${SCRIPT_DIR}/build-image" "${SECURITY_MODE}"

# Generate the security-specific Compose configuration.
"${SCRIPT_DIR}/generate-compose-overlay" "${SECURITY_MODE}"

# Start the DevPod workspace.
"${SCRIPT_DIR}/recreate-workspace" "${SECURITY_MODE}"
