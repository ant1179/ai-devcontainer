#!/usr/bin/env bash

set -euo pipefail

SECURITY_MODE="${1:?Security mode required: hardened or bunkered}"
RECREATE="${2:-false}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ "${SECURITY_MODE}" != "hardened" && "${SECURITY_MODE}" != "bunkered" ]]; then
  echo "Invalid security mode: ${SECURITY_MODE}" >&2
  exit 1
fi

DEVPOD_UP_ARGS=()

if [[ "${RECREATE}" == "true" ]]; then
  DEVPOD_UP_ARGS+=(--recreate)
fi

echo
echo "Starting DevPod (${SECURITY_MODE})..."
echo

if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  echo "Dotfiles: enabled"

  devpod up "${REPO_ROOT}" \
    "${DEVPOD_UP_ARGS[@]}" \
    --context "${SECURITY_MODE}" \
    --ide none \
    --dotfiles git@github.com:ant1179/dotfiles-devpods.git
else
  echo "Dotfiles: disabled (bunkered mode)"

  devpod up "${REPO_ROOT}" \
    "${DEVPOD_UP_ARGS[@]}" \
    --context "${SECURITY_MODE}" \
    --ide none
fi
