#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "Usage:"
  echo "  $0 up [--recreate]"
}

command="${1:-}"

case "${command}" in
  up)
    shift

    RECREATE=false

    if [[ "${1:-}" == "--recreate" ]]; then
      RECREATE=true
      shift
    fi

    if [[ $# -ne 0 ]]; then
      usage
      exit 1
    fi

    "${SCRIPT_DIR}/bootstrap" "${RECREATE}"
    ;;

  *)
    usage
    exit 1
    ;;
esac
