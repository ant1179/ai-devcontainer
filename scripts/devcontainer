#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTERNAL_DIR="${SCRIPT_DIR}/internal"

usage() {
  echo "Usage:"
  echo "  $0 up [--recreate]"
  echo "  $0 ssh"
  echo "  $0 delete"
}

select_security_mode() {
  echo "Security mode:"
  echo
  echo "  1) hardened  - sudo available, password required every time"
  echo "  2) bunkered  - privilege escalation completely disabled"
  echo

  while true; do
    printf "Select mode [1/2]: "
    read -r choice

    case "${choice}" in
    1)
      SECURITY_MODE="hardened"
      break
      ;;
    2)
      SECURITY_MODE="bunkered"
      break
      ;;
    *)
      echo "Invalid choice."
      ;;
    esac
  done

  echo
  echo "Security mode: ${SECURITY_MODE}"
}

command="${1:-}"

case "${command}" in
up)
  shift

  if [[ "${1:-}" == "--recreate" ]]; then
    shift

    if [[ $# -ne 0 ]]; then
      usage
      exit 1
    fi

    # Recreate and fully configure the devcontainer.
    select_security_mode
    "${INTERNAL_DIR}/bootstrap" "${SECURITY_MODE}"
  else
    if [[ $# -ne 0 ]]; then
      usage
      exit 1
    fi

    # Start the existing devcontainer without changing its configuration.
    "${INTERNAL_DIR}/devpod" up . --ide none
  fi
  ;;

ssh)
  shift

  if [[ $# -ne 0 ]]; then
    usage
    exit 1
  fi

  # Connect to the existing devcontainer without changing its configuration.
  "${INTERNAL_DIR}/devpod" ssh .
  ;;

delete)
  shift

  if [[ $# -ne 0 ]]; then
    usage
    exit 1
  fi

  "${INTERNAL_DIR}/devpod" delete .
  ;;

*)
  usage
  exit 1
  ;;
esac
