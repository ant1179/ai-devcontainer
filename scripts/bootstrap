#!/usr/bin/env bash

set -euo pipefail

RECREATE="${1:-false}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DENYLIST_FILE="${REPO_ROOT}/.devcontainer/ai-denylist"
PROJECT_NAME="$(basename "${REPO_ROOT}")"
SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"

if [[ ! -f "${DENYLIST_FILE}" ]]; then
  echo "Missing denylist: ${DENYLIST_FILE}" >&2
  exit 1
fi

echo "Security mode:"
echo
echo "  1) hardened  - sudo available, password required every time"
echo "  2) bunkered  - privilege escalation completely disabled"
echo

while true; do
  printf "Select mode [1/2]: "
  read -r choice

  case "${choice}" in
  1)
    SECURITY_MODE="hardened"
    break
    ;;
  2)
    SECURITY_MODE="bunkered"
    break
    ;;
  *)
    echo "Invalid choice."
    ;;
  esac
done

echo
echo "Security mode: ${SECURITY_MODE}"

# Make the selected security mode the active DevPod context.
devpod context use "${SECURITY_MODE}"
echo

# Prepare persistent build secrets.
"${SCRIPT_DIR}/setup-secrets" "${SECURITY_MODE}"

# Configure the dedicated SSH agent for the selected security mode.
"${SCRIPT_DIR}/setup-ssh-agent" "${SECURITY_MODE}"

if [[ "${SECURITY_MODE}" == "hardened" && -f "${SSH_AGENT_ENV}" ]]; then
  # Make the dedicated SSH agent available to DevPod.
  # shellcheck disable=SC1090
  source "${SSH_AGENT_ENV}"
  export SSH_AUTH_SOCK
  export SSH_AGENT_PID
else
  unset SSH_AUTH_SOCK || true
  unset SSH_AGENT_PID || true
fi

# Build the devcontainer image.
"${SCRIPT_DIR}/build-image" "${SECURITY_MODE}"

# Generate the security-specific Compose configuration.
"${SCRIPT_DIR}/generate-compose" "${SECURITY_MODE}"

echo "Bootstrap configuration complete."

echo
echo "Starting DevPod (${SECURITY_MODE})..."
echo

# Start the DevPod workspace.
"${SCRIPT_DIR}/start-devpod" "${SECURITY_MODE}" "${RECREATE}"
