#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DENYLIST_FILE="${REPO_ROOT}/.devcontainer/ai-denylist"
GENERATED_FILE="${REPO_ROOT}/.devcontainer/docker-compose.generated.yaml"
ENV_FILE="${REPO_ROOT}/.devcontainer/.env"
GITIGNORE_FILE="${REPO_ROOT}/.gitignore"

if [[ ! -f "${DENYLIST_FILE}" ]]; then
  echo "Missing denylist: ${DENYLIST_FILE}" >&2
  exit 1
fi

echo "Security mode:"
echo
echo "  1) hardened  - sudo available, password required every time"
echo "  2) bunkered  - privilege escalation completely disabled"
echo

while true; do
  printf "Select mode [1/2]: "
  read -r choice

  case "${choice}" in
  1)
    SECURITY_MODE="hardened"
    break
    ;;
  2)
    SECURITY_MODE="bunkered"
    break
    ;;
  *)
    echo "Invalid choice."
    ;;
  esac
done

echo
echo "Security mode: ${SECURITY_MODE}"
echo

if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  while true; do
    printf "Sudo password: "
    stty -echo
    read -r password
    stty echo
    echo

    printf "Confirm sudo password: "
    stty -echo
    read -r password_confirm
    stty echo
    echo

    if [[ "${password}" != "${password_confirm}" ]]; then
      echo "Passwords do not match."
      continue
    fi

    if [[ -z "${password}" ]]; then
      echo "Password cannot be empty."
      continue
    fi

    break
  done

  VSCODE_PASSWORD_HASH="$(
    printf '%s' "${password}" | openssl passwd -6 -stdin
  )"

  unset password
  unset password_confirm

  # Escape $ for Docker Compose .env interpolation.
  VSCODE_PASSWORD_HASH_ESCAPED="$(
    printf '%s' "${VSCODE_PASSWORD_HASH}" | sed 's/\$/$$/g'
  )"

  if [[ -f "${ENV_FILE}" ]] && grep -q '^VSCODE_PASSWORD_HASH=' "${ENV_FILE}"; then
    tmp_env="$(mktemp)"

    grep -v '^VSCODE_PASSWORD_HASH=' "${ENV_FILE}" >"${tmp_env}" || true
    printf 'VSCODE_PASSWORD_HASH=%s\n' "${VSCODE_PASSWORD_HASH_ESCAPED}" >>"${tmp_env}"

    mv "${tmp_env}" "${ENV_FILE}"
  else
    printf 'VSCODE_PASSWORD_HASH=%s\n' "${VSCODE_PASSWORD_HASH_ESCAPED}" >>"${ENV_FILE}"
  fi

  unset VSCODE_PASSWORD_HASH
  unset VSCODE_PASSWORD_HASH_ESCAPED
fi

# Ensure the local environment file cannot be committed.
if ! grep -qxF '.devcontainer/.env' "${GITIGNORE_FILE}" 2>/dev/null; then
  printf '\n.devcontainer/.env\n' >>"${GITIGNORE_FILE}"
  echo "Added .devcontainer/.env to .gitignore"
fi

# Configure the GitHub token used by mise during the image build.
if grep -q '^MISE_GITHUB_TOKEN=.' "${ENV_FILE}" 2>/dev/null; then
  echo "GitHub token: already configured"
else
  while true; do
    printf "GitHub token for mise: "
    stty -echo
    read -r github_token
    stty echo
    echo

    if [[ -z "${github_token}" ]]; then
      echo "Token cannot be empty."
      continue
    fi

    break
  done

  if [[ -f "${ENV_FILE}" ]]; then
    tmp_env="$(mktemp)"

    grep -v '^MISE_GITHUB_TOKEN=' "${ENV_FILE}" >"${tmp_env}" || true
    printf 'MISE_GITHUB_TOKEN=%s\n' "${github_token}" >>"${tmp_env}"

    mv "${tmp_env}" "${ENV_FILE}"
  else
    printf 'MISE_GITHUB_TOKEN=%s\n' "${github_token}" >"${ENV_FILE}"
  fi

  unset github_token

  echo "GitHub token: configured"
fi

chmod 600 "${ENV_FILE}"

TMP_MATCHES="$(mktemp)"
trap 'rm -f "${TMP_MATCHES}"' EXIT

while IFS= read -r pattern; do
  [[ -z "${pattern}" ]] && continue
  [[ "${pattern}" =~ ^[[:space:]]*# ]] && continue

  (
    cd "${REPO_ROOT}"

    find . \
      -path "./.git" -prune \
      -o -path "./${pattern}" -print
  ) >>"${TMP_MATCHES}"

done <"${DENYLIST_FILE}"

{
  echo "services:"
  echo "  app:"

  echo "    cap_drop:"
  echo "      - ALL"

  if [[ "${SECURITY_MODE}" == "hardened" ]]; then
    echo "    cap_add:"
    echo "      - SETUID"
    echo "      - SETGID"
    echo "      - AUDIT_WRITE"
  else
    echo "    security_opt:"
    echo "      - no-new-privileges:true"
  fi

  echo "    volumes:"

  sort -u "${TMP_MATCHES}" | while IFS= read -r file; do
    relative="${file#./}"

    if [[ -d "${REPO_ROOT}/${relative}" ]]; then
      echo "      - type: tmpfs"
      echo "        target: /workspace/${relative}"
    else
      echo "      - /dev/null:/workspace/${relative}:ro"
    fi
  done

} >"${GENERATED_FILE}"

echo
echo "Generated: ${GENERATED_FILE}"
echo "Bootstrap configuration complete."
