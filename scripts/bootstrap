#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DENYLIST_FILE="${REPO_ROOT}/.devcontainer/ai-denylist"
GENERATED_FILE="${REPO_ROOT}/.devcontainer/docker-compose.generated.yaml"
PROJECT_NAME="$(basename "${REPO_ROOT}")"
SECRETS_DIR="${HOME}/.config/ai-devcontainer/${PROJECT_NAME}"
ENV_FILE="${SECRETS_DIR}/secrets.env"
SSH_AGENT_ENV="${SECRETS_DIR}/ssh-agent.env"

mkdir -p "${SECRETS_DIR}"
chmod 700 "${SECRETS_DIR}"
touch "${ENV_FILE}"
chmod 600 "${ENV_FILE}"

if [[ ! -f "${DENYLIST_FILE}" ]]; then
  echo "Missing denylist: ${DENYLIST_FILE}" >&2
  exit 1
fi

cleanup_ssh_agent() {
  if [[ ! -f "${SSH_AGENT_ENV}" ]]; then
    return
  fi

  OLD_SSH_AGENT_PID="$(
    grep '^SSH_AGENT_PID=' "${SSH_AGENT_ENV}" 2>/dev/null |
      cut -d= -f2- || true
  )"

  if [[ -n "${OLD_SSH_AGENT_PID}" ]] &&
    kill -0 "${OLD_SSH_AGENT_PID}" 2>/dev/null; then

    PROCESS_NAME="$(
      ps -p "${OLD_SSH_AGENT_PID}" -o comm= 2>/dev/null || true
    )"

    if [[ "${PROCESS_NAME}" == *ssh-agent* ]]; then
      echo "Stopping previous dedicated SSH agent..."
      kill "${OLD_SSH_AGENT_PID}"
    fi
  fi

  rm -f "${SSH_AGENT_ENV}"
}

setup_ssh_agent() {
  cleanup_ssh_agent

  echo
  echo "Available SSH private keys:"
  echo

  SSH_KEYS=()

  for key in "${HOME}"/.ssh/*; do
    [[ -f "${key}" ]] || continue

    case "${key}" in
    *.pub | known_hosts* | authorized_keys | config)
      continue
      ;;
    esac

    if ssh-keygen -y -f "${key}" >/dev/null 2>&1; then
      SSH_KEYS+=("${key}")
    fi
  done

  if [[ "${#SSH_KEYS[@]}" -eq 0 ]]; then
    echo "No SSH private keys found."
    return
  fi

  i=1
  for key in "${SSH_KEYS[@]}"; do
    printf "  %d) %s\n" "${i}" "${key}"
    i=$((i + 1))
  done

  echo
  printf "Select keys to expose [e.g. 1 2, empty for none]: "
  read -r selection

  if [[ -z "${selection}" ]]; then
    echo "SSH agent: disabled"
    return
  fi

  AGENT_OUTPUT="$(ssh-agent -s)"

  SSH_AUTH_SOCK="$(
    printf '%s\n' "${AGENT_OUTPUT}" |
      sed -n 's/^SSH_AUTH_SOCK=\([^;]*\);.*/\1/p'
  )"

  SSH_AGENT_PID="$(
    printf '%s\n' "${AGENT_OUTPUT}" |
      sed -n 's/^SSH_AGENT_PID=\([^;]*\);.*/\1/p'
  )"

  if [[ -z "${SSH_AUTH_SOCK}" ]] ||
    [[ -z "${SSH_AGENT_PID}" ]]; then
    echo "Failed to start dedicated SSH agent." >&2
    exit 1
  fi

  for index in ${selection}; do
    if ! [[ "${index}" =~ ^[0-9]+$ ]] ||
      ((index < 1 || index > ${#SSH_KEYS[@]})); then

      echo "Invalid SSH key selection: ${index}" >&2
      kill "${SSH_AGENT_PID}" 2>/dev/null || true
      exit 1
    fi

    key="${SSH_KEYS[$((index - 1))]}"

    SSH_AUTH_SOCK="${SSH_AUTH_SOCK}" \
      ssh-add "${key}"
  done

  {
    printf 'SSH_AUTH_SOCK=%s\n' "${SSH_AUTH_SOCK}"
    printf 'SSH_AGENT_PID=%s\n' "${SSH_AGENT_PID}"
  } >"${SSH_AGENT_ENV}"

  chmod 600 "${SSH_AGENT_ENV}"

  echo
  echo "Dedicated SSH agent:"
  SSH_AUTH_SOCK="${SSH_AUTH_SOCK}" ssh-add -l
}

echo "Security mode:"
echo
echo "  1) hardened  - sudo available, password required every time"
echo "  2) bunkered  - privilege escalation completely disabled"
echo

while true; do
  printf "Select mode [1/2]: "
  read -r choice

  case "${choice}" in
  1)
    SECURITY_MODE="hardened"
    break
    ;;
  2)
    SECURITY_MODE="bunkered"
    break
    ;;
  *)
    echo "Invalid choice."
    ;;
  esac
done

echo
echo "Security mode: ${SECURITY_MODE}"
echo

if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  setup_ssh_agent

  # Make the dedicated SSH agent available to processes
  # launched later by this bootstrap.
  # shellcheck disable=SC1090
  source "${SSH_AGENT_ENV}"
  export SSH_AUTH_SOCK
  export SSH_AGENT_PID
else
  cleanup_ssh_agent

  # Do not expose the host SSH agent in bunkered mode.
  unset SSH_AUTH_SOCK || true
  unset SSH_AGENT_PID || true

  echo "SSH agent: disabled (bunkered mode)"
fi

if [[ "${SECURITY_MODE}" == "hardened" ]]; then
  while true; do
    printf "Sudo password: "
    stty -echo
    read -r password
    stty echo
    echo

    printf "Confirm sudo password: "
    stty -echo
    read -r password_confirm
    stty echo
    echo

    if [[ "${password}" != "${password_confirm}" ]]; then
      echo "Passwords do not match."
      continue
    fi

    if [[ -z "${password}" ]]; then
      echo "Password cannot be empty."
      continue
    fi

    break
  done

  EXISTING_PASSWORD_HASH="$(
    grep '^VSCODE_PASSWORD_HASH=' "${ENV_FILE}" 2>/dev/null |
      cut -d= -f2- || true
  )"

  EXISTING_PASSWORD_CACHE_KEY="$(
    grep '^VSCODE_PASSWORD_CACHE_KEY=' "${ENV_FILE}" 2>/dev/null |
      cut -d= -f2- || true
  )"

  PASSWORD_UNCHANGED=false

  if [[ -n "${EXISTING_PASSWORD_HASH}" ]] &&
    [[ -n "${EXISTING_PASSWORD_CACHE_KEY}" ]]; then

    EXISTING_SALT="$(
      printf '%s' "${EXISTING_PASSWORD_HASH}" |
        cut -d'$' -f3
    )"

    CHECKED_HASH="$(
      printf '%s' "${password}" |
        openssl passwd -6 \
          -salt "${EXISTING_SALT}" \
          -stdin
    )"

    if [[ "${CHECKED_HASH}" == "${EXISTING_PASSWORD_HASH}" ]]; then
      PASSWORD_UNCHANGED=true
    fi
  fi

  if [[ "${PASSWORD_UNCHANGED}" == "true" ]]; then
    echo "Sudo password: unchanged"

    VSCODE_PASSWORD_HASH="${EXISTING_PASSWORD_HASH}"
    VSCODE_PASSWORD_CACHE_KEY="${EXISTING_PASSWORD_CACHE_KEY}"
  else
    echo "Sudo password: updated"

    VSCODE_PASSWORD_HASH="$(
      printf '%s' "${password}" |
        openssl passwd -6 -stdin
    )"

    VSCODE_PASSWORD_CACHE_KEY="$(openssl rand -hex 16)"

    tmp_env="$(mktemp)"

    grep -v -E '^(VSCODE_PASSWORD_HASH|VSCODE_PASSWORD_CACHE_KEY)=' \
      "${ENV_FILE}" >"${tmp_env}" || true

    printf 'VSCODE_PASSWORD_HASH=%s\n' \
      "${VSCODE_PASSWORD_HASH}" >>"${tmp_env}"

    printf 'VSCODE_PASSWORD_CACHE_KEY=%s\n' \
      "${VSCODE_PASSWORD_CACHE_KEY}" >>"${tmp_env}"

    mv "${tmp_env}" "${ENV_FILE}"
    chmod 600 "${ENV_FILE}"
  fi

  unset password
  unset password_confirm
  unset EXISTING_PASSWORD_HASH
  unset EXISTING_PASSWORD_CACHE_KEY
  unset EXISTING_SALT
  unset CHECKED_HASH
  unset PASSWORD_UNCHANGED
  unset VSCODE_PASSWORD_HASH
  unset VSCODE_PASSWORD_CACHE_KEY
fi

# Configure the GitHub token used by mise during the image build.
if grep -q '^MISE_GITHUB_TOKEN=.' "${ENV_FILE}" 2>/dev/null; then
  echo "GitHub token: already configured"
else
  while true; do
    printf "GitHub token for mise: "
    stty -echo
    read -r github_token
    stty echo
    echo

    if [[ -z "${github_token}" ]]; then
      echo "Token cannot be empty."
      continue
    fi

    break
  done

  tmp_env="$(mktemp)"

  grep -v '^MISE_GITHUB_TOKEN=' "${ENV_FILE}" >"${tmp_env}" || true
  printf 'MISE_GITHUB_TOKEN=%s\n' "${github_token}" >>"${tmp_env}"

  mv "${tmp_env}" "${ENV_FILE}"
  chmod 600 "${ENV_FILE}"

  unset github_token

  echo "GitHub token: configured"
fi

chmod 600 "${ENV_FILE}"

IMAGE_NAME="ai-devcontainer:local"

# Read build credentials without exporting them globally.
MISE_GITHUB_TOKEN="$(
  grep '^MISE_GITHUB_TOKEN=' "${ENV_FILE}" |
    cut -d= -f2-
)"

VSCODE_PASSWORD_HASH="$(
  grep '^VSCODE_PASSWORD_HASH=' "${ENV_FILE}" |
    cut -d= -f2-
)"

VSCODE_PASSWORD_CACHE_KEY="$(
  grep '^VSCODE_PASSWORD_CACHE_KEY=' "${ENV_FILE}" |
    cut -d= -f2-
)"

if [[ -z "${MISE_GITHUB_TOKEN}" ]]; then
  echo "Missing MISE_GITHUB_TOKEN." >&2
  exit 1
fi

if [[ "${SECURITY_MODE}" == "hardened" ]] &&
  [[ -z "${VSCODE_PASSWORD_HASH}" ]]; then
  echo "Missing VSCODE_PASSWORD_HASH." >&2
  exit 1
fi

if [[ "${SECURITY_MODE}" == "hardened" ]] &&
  [[ -z "${VSCODE_PASSWORD_CACHE_KEY}" ]]; then
  echo "Missing VSCODE_PASSWORD_CACHE_KEY." >&2
  exit 1
fi

echo
echo "Building devcontainer image..."

MISE_GITHUB_TOKEN="${MISE_GITHUB_TOKEN}" \
  VSCODE_PASSWORD_HASH="${VSCODE_PASSWORD_HASH}" \
  podman build \
  --build-arg VSCODE_PASSWORD_CACHE_KEY="${VSCODE_PASSWORD_CACHE_KEY}" \
  --secret id=mise_github_token,env=MISE_GITHUB_TOKEN \
  --secret id=vscode_password_hash,env=VSCODE_PASSWORD_HASH \
  -f "${REPO_ROOT}/.devcontainer/Dockerfile" \
  -t "${IMAGE_NAME}" \
  "${REPO_ROOT}"

unset MISE_GITHUB_TOKEN
unset VSCODE_PASSWORD_HASH
unset VSCODE_PASSWORD_CACHE_KEY

echo "Image built: ${IMAGE_NAME}"

TMP_MATCHES="$(mktemp)"
trap 'rm -f "${TMP_MATCHES}"' EXIT

while IFS= read -r pattern; do
  [[ -z "${pattern}" ]] && continue
  [[ "${pattern}" =~ ^[[:space:]]*# ]] && continue

  (
    cd "${REPO_ROOT}"

    find . \
      -path "./.git" -prune \
      -o -path "./${pattern}" -print
  ) >>"${TMP_MATCHES}"

done <"${DENYLIST_FILE}"

{
  echo "services:"
  echo "  app:"

  echo "    cap_drop:"
  echo "      - ALL"

  if [[ "${SECURITY_MODE}" == "hardened" ]]; then
    echo "    cap_add:"
    echo "      - SETUID"
    echo "      - SETGID"
    echo "      - AUDIT_WRITE"
    echo "      - DAC_OVERRIDE"
  else
    echo "    cap_add:"
    echo "      - SETUID"
    echo "      - SETGID"
    echo "      - CHOWN"
    echo "      - DAC_OVERRIDE"
    echo "    security_opt:"
    echo "      - no-new-privileges:true"
  fi

  echo "    volumes:"

  sort -u "${TMP_MATCHES}" | while IFS= read -r file; do
    relative="${file#./}"

    if [[ -d "${REPO_ROOT}/${relative}" ]]; then
      echo "      - type: tmpfs"
      echo "        target: /workspaces/vscode/${relative}"
      echo "        tmpfs:"
      echo "          mode: 0700"
    else
      echo "      - /dev/null:/workspaces/vscode/${relative}:ro"
    fi
  done

} >"${GENERATED_FILE}"

echo
echo "Generated: ${GENERATED_FILE}"
echo "Bootstrap configuration complete."
